{
  "name": "throwpaper",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:forms": "pnpm --parallel --filter @tp/api-forms --filter @tp/forms run dev",
    "dev:mailer": "pnpm --parallel --filter @tp/api-mailer --filter @tp/mailer run dev",
    "dev:sign": "pnpm --parallel --filter @tp/api-sign --filter @tp/sign run dev",
    "demo": "pnpm --parallel --filter @tp/api-forms --filter @tp/forms run demo",
    "icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "contract:check": "tsx scripts/contract-check.ts",
    "licence:check": "tsx scripts/licence-check.ts",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "tokens:proof": "tsx scripts/proof/index.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tp/api-forms db:migrate",
    "db:generate": "pnpm --filter @tp/api-forms db:generate",
    "db:seed": "pnpm --filter @tp/api-forms db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tp/api-forms": "workspace:*",
    "@tp/api-mailer": "workspace:*",
    "@tp/api-sign": "workspace:*",
    "@tp/shared": "workspace:*",
    "@tp/tokens": "workspace:^",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.12.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "postgres": "^3.4.5",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
