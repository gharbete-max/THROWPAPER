{
  "name": "throwpaper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:forms": "pnpm --filter @tp/api-forms dev & pnpm --filter @tp/forms dev",
    "dev:mailer": "pnpm --filter @tp/api-mailer dev & pnpm --filter @tp/mailer dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "contract:check": "tsx scripts/contract-check.ts",
    "tokens:proof": "tsx scripts/proof/index.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tp/api-forms db:migrate",
    "db:generate": "pnpm --filter @tp/api-forms db:generate",
    "db:seed": "pnpm --filter @tp/api-forms db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tp/api-forms": "workspace:*",
    "@tp/api-mailer": "workspace:*",
    "@tp/shared": "workspace:*",
    "@tp/tokens": "workspace:^",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.62.1",
    "postgres": "^3.4.5",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
