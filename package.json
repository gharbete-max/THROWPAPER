{
  "name": "throwpaper",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:forms": "pnpm --parallel --filter @tp/api-forms --filter @tp/forms run dev",
    "dev:sign": "pnpm --parallel --filter @tp/api-sign --filter @tp/sign run dev",
    "demo": "pnpm --parallel --filter @tp/api-forms --filter @tp/forms run demo",
    "icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "contract:check": "tsx scripts/contract-check.ts",
    "builder:validate": "tsx scripts/builder-validate.ts",
    "corpus:build": "tsx scripts/corpus/build.ts",
    "corpus:scan": "tsx scripts/corpus/scan.ts",
    "licence:check": "tsx scripts/licence-check.ts",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "tokens:proof": "tsx scripts/proof/index.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:smoke": "tsx scripts/run-e2e.ts --grep @smoke",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @tp/api-forms --filter @tp/api-sign db:migrate",
    "db:generate": "pnpm --filter @tp/api-forms db:generate",
    "db:seed": "pnpm --filter @tp/api-forms --filter @tp/api-sign db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tp/api-forms": "workspace:*",
    "@tp/api-sign": "workspace:*",
    "@tp/shared": "workspace:*",
    "@tp/tokens": "workspace:^",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.13.0",
    "pdfjs-dist": "6.3.289",
    "playwright": "^1.64.1",
    "postgres": "^3.4.5",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.6"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "nodemailer@<10.1.4": "^10.1.4",
      "shell-quote@<1.11.0": "^1.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "serialize-javascript@<7.1.3": "^7.1.3"
    }
  }
}
