# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://throwpaper:throwpaper@localhost:5432/throwpaper
API_FORMS_PORT=4001
# Interface the API listens on. 127.0.0.1 on a laptop: the port is then not on the LAN, which
# matters once TRUST_PROXY names a local forwarder. The Docker image sets 0.0.0.0 itself.
API_FORMS_HOST=127.0.0.1
API_MAILER_PORT=4002

# Connection pool and query limits. The defaults below are applied when these are unset and suit a
# long-lived container, which is what the Dockerfile builds. They are variables rather than
# constants because the right values follow the hosting decision, which is still open
# (LAUNCH-CHECKLIST.md §3): serverless wants DATABASE_POOL_MAX=1 per instance in front of a pooler
# such as PgBouncer, where a pool of ten per instance exhausts the database instead.
# Migrations and seeding use their own connection and are not governed by the statement timeout —
# an index build on a real table runs for minutes. See apps/api-forms/src/db/client.ts.
#DATABASE_POOL_MAX=10
#DATABASE_IDLE_TIMEOUT_SECONDS=30
#DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Postgres cancels a query that runs longer than this. 0 disables it.
#DATABASE_STATEMENT_TIMEOUT_MS=15000
# Closes a transaction left open between BEGIN and COMMIT, which a statement timeout cannot catch
# because the session is idle — and still holding every lock it took.
#DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Signs access tokens. Must be at least 32 characters; generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=development-only-secret-change-me-please

# Signs download links (bulk exports). Its own secret: a key that signs both sessions and links is
# a key whose leak does both. Same rule — at least 32 characters, generated per environment with
# the same command — and the server refuses to start if it equals JWT_SECRET. Rotating it
# invalidates every outstanding download link and nothing else.
DOCUMENT_SIGNING_SECRET=development-only-document-secret-change-me

# Sign (apps/api-sign) keeps its own database; `pnpm db:migrate` creates it when missing.
SIGN_DATABASE_URL=postgres://throwpaper:throwpaper@localhost:5432/throwpaper_sign
# Signing links are derived from this. At least 32 characters, per environment, same command as
# above. Rotating it revokes every outstanding signing link at once. api-sign refuses to start
# without it.
SIGN_LINK_SECRET=development-only-sign-link-secret-change-me
# Where signers open their links (apps/sign).
SIGN_PUBLIC_URL=http://localhost:5175
# Where api-sign is reachable from outside; sealed-document download links point here.
API_SIGN_PUBLIC_URL=http://localhost:4003
# The key and certificate completed envelopes are sealed with (PEM; one line with \n is fine).
# api-sign refuses to start without them. For development, generate a self-issued pair with
#   pnpm --filter @tp/api-sign seal:dev-cert
# which appends both to .env. A self-issued certificate proves a sealed file was not changed and
# nothing about who sealed it; a trusted seal needs a qualified certificate (LAUNCH-CHECKLIST §6).
# SIGN_SEAL_KEY=
# SIGN_SEAL_CERT=

# Base URL of apps/forms. Magic links point here and CORS is scoped to it.
APP_URL=http://localhost:5173

# Which proxies in front of the API may be believed about the client's address.
# Empty is correct on localhost and WRONG once deployed: every rate limit keys on the client IP,
# so behind a TLS terminator all visitors share one bucket and six requests lock the whole tenant
# out of sign-in. A list, not `true`, because trusting the whole X-Forwarded-For header lets a
# client forge its own address and walk around the limits.
# Comma-separated; takes addresses, CIDR ranges, or loopback / linklocal / uniquelocal.
# Example: TRUST_PROXY=10.0.0.0/8,uniquelocal
TRUST_PROXY=

# ── Through ngrok (the local track) ──────────────────────────────────────────────────────────
# Proven 2026-09-21 (docs/PROGRESS.md § L2) with the built app served by the API:
#   pnpm --filter @tp/forms build
#   ngrok http 4001                      # a free-plan URL is new every run; read it from
#   curl -s http://127.0.0.1:4040/api/tunnels   # -> "public_url"
# then start the API with, for that run:
#   APP_URL=https://<subdomain>.ngrok-free.dev   # magic links, resume links and CORS use it
#   TRUST_PROXY=loopback                          # the ngrok agent connects from 127.0.0.1 and
#                                                 # is the only hop to believe; a LAN neighbour
#                                                 # hitting the port directly is not loopback and
#                                                 # is not believed
#   API_FORMS_HOST=127.0.0.1
#   MAIL_PROVIDER=console                         # nothing is ever sent
#   SERVE_APP=<repo>/apps/forms/dist
# A random ngrok URL cannot be written here once; it is an argument to that run.

# Mail. `console` prints to the log; `ses` sends through Amazon SES.
# Region is eu-north-1 (Stockholm) so recipient data stays in Sweden - START-HERE decision 4.
MAIL_PROVIDER=console
MAIL_REGION=eu-north-1
MAIL_FROM=
# Optional SES configuration set, for the delivery event stream B11 will consume.
MAIL_CONFIGURATION_SET=
# Where the operator notification for a new registration goes.
MAIL_OPERATOR=
# Where the marketing site's "get in touch" form goes. Unset, the form answers 503.
CONTACT_TO=

# Where generated documents are written. A local stopgap until an object store is chosen.
DOCUMENT_DIR=.documents
