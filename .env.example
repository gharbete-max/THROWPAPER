# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://throwpaper:throwpaper@localhost:5432/throwpaper
API_FORMS_PORT=4001
API_MAILER_PORT=4002

# Connection pool and query limits. The defaults below are applied when these are unset and suit a
# long-lived container, which is what the Dockerfile builds. They are variables rather than
# constants because the right values follow the hosting decision, which is still open
# (LAUNCH-CHECKLIST.md §3): serverless wants DATABASE_POOL_MAX=1 per instance in front of a pooler
# such as PgBouncer, where a pool of ten per instance exhausts the database instead.
# Migrations and seeding use their own connection and are not governed by the statement timeout —
# an index build on a real table runs for minutes. See apps/api-forms/src/db/client.ts.
#DATABASE_POOL_MAX=10
#DATABASE_IDLE_TIMEOUT_SECONDS=30
#DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Postgres cancels a query that runs longer than this. 0 disables it.
#DATABASE_STATEMENT_TIMEOUT_MS=15000
# Closes a transaction left open between BEGIN and COMMIT, which a statement timeout cannot catch
# because the session is idle — and still holding every lock it took.
#DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Signs access tokens. Must be at least 32 characters; generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=development-only-secret-change-me-please

# Base URL of apps/forms. Magic links point here and CORS is scoped to it.
APP_URL=http://localhost:5173

# Which proxies in front of the API may be believed about the client's address.
# Empty is correct on localhost and WRONG once deployed: every rate limit keys on the client IP,
# so behind a TLS terminator all visitors share one bucket and six requests lock the whole tenant
# out of sign-in. A list, not `true`, because trusting the whole X-Forwarded-For header lets a
# client forge its own address and walk around the limits.
# Comma-separated; takes addresses, CIDR ranges, or loopback / linklocal / uniquelocal.
# Example: TRUST_PROXY=10.0.0.0/8,uniquelocal
TRUST_PROXY=

# Mail. `console` prints to the log; `ses` sends through Amazon SES.
# Region is eu-north-1 (Stockholm) so recipient data stays in Sweden - START-HERE decision 4.
MAIL_PROVIDER=console
MAIL_REGION=eu-north-1
MAIL_FROM=
# Optional SES configuration set, for the delivery event stream B11 will consume.
MAIL_CONFIGURATION_SET=
# Where the operator notification for a new registration goes.
MAIL_OPERATOR=
# Where the marketing site's "get in touch" form goes. Unset, the form answers 503.
CONTACT_TO=

# Where generated documents are written. A local stopgap until an object store is chosen.
DOCUMENT_DIR=.documents
