* text=auto eol=lf
# sheets/ only (a wider rule rewrites the pinned skill copies, scripts/skills.test.ts): Windows PowerShell
# 5.1 and cmd.exe get Windows line endings; the .ps1 files also keep a UTF-8 BOM,
# without which PowerShell 5.1 reads them as Windows-1252 (sheets/README.md).
sheets/**/*.ps1 text eol=crlf
sheets/**/*.cmd text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
docs/brand/**/*.webp filter=lfs diff=lfs merge=lfs -text
docs/brand/**/*.gif filter=lfs diff=lfs merge=lfs -text
docs/brand/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/brand/**/*.jpg filter=lfs diff=lfs merge=lfs -text
# Test files for sheets/: their exact bytes are the test (encodings, line endings).
sheets/tests/fixtures/** binary
