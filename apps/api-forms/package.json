{
  "name": "@tp/api-forms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract-registry": "./src/contract-registry.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "start:demo": "node dist/demo/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1123.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tp/calc": "workspace:*",
    "@tp/i18n": "workspace:*",
    "@tp/shared": "workspace:*",
    "@tp/tokens": "workspace:*",
    "archiver": "^8.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.10",
    "playwright": "^1.62.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.1",
    "tsup": "^8.3.5"
  }
}
