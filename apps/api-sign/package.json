{
  "name": "@tp/api-sign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contract-registry": "./src/contract-registry.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --target node20 --clean",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed.ts",
    "seal:dev-cert": "tsx src/sealing/dev-cert-cli.ts"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "@tp/i18n": "workspace:^",
    "@tp/shared": "workspace:*",
    "@tp/signing": "workspace:*",
    "@tp/tokens": "workspace:^",
    "asn1js": "^3.0.10",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^4.0.2",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.3.5"
  }
}
